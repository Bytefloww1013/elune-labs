{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["categories", "products"],
  "properties": {
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "url_key"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "url_key": { "type": "string", "minLength": 1 }
        }
      }
    },
    "products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sku", "size", "price", "category", "qty"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "sku": { "type": "string", "minLength": 1 },
          "family": { "type": "string", "minLength": 1 },
          "size": { "type": "string", "pattern": "^(?:[1-9]\\d*|0\\.\\d*[1-9]\\d*|[1-9]\\d*\\.\\d+)mg$" },
          "price": { "type": "number", "minimum": 0 },
          "category": { "type": "string", "minLength": 1 },
          "qty": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
