
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Elune Labs runtime / local
.env
backups/
themes/*/dist/
themes/*/node_modules/

# Grok dir
.grok/

# Oh My Pi harness dir. Installed skills (18MB of vendored suites), agents and
# extensions are tooling, not project source. .omp/beadfinder/state.json stays
# tracked — that is plan memory, not tooling.
.omp/skills/
.omp/agents/
.omp/extensions/


# Treehouse work tree storage dir
.treehouse/

# Impeccable - UI Design skill/plugin output dirs
# impeccable-ignore-start
# Ephemeral output, runtime state, and per-dev overrides.
# Unanchored: .impeccable may sit at the repo root or under a nested
# workspace (apps/web/.impeccable/...); anchored patterns would miss it.
# Shared artifacts stay tracked: config.json, live/config.json,
# design.json, surfaces/*.md, critique/*.md.
.impeccable/
.impeccable/config.local.json
.impeccable/hook.cache.json
.impeccable/hook.pending.json
.impeccable/*.png
.impeccable/review/
.impeccable/questions/
.impeccable/live/server.json
.impeccable/live/sessions/
.impeccable/live/previews/
.impeccable/live/annotations/
.impeccable/live/cache/
.impeccable/live/manual-edit-apply-transaction.json
.impeccable/live/manual-edit-events.jsonl
.impeccable/live/manual-edit-evidence/
.impeccable/live/pending-manual-edits.json
.impeccable/live/deferred-svelte-component-accepts.json
.impeccable/live/*.png
# impeccable-ignore-end

# The locked visual world is durable project memory: the chosen direction, the
# challenger verdicts, and the fallback the owner asked to keep. Small JSON
# only — comp rasters stay local (they are large and regenerable from prompts).
#
# DESIGN.md's sidecar and the persisted surface briefs are the same kind of
# durable memory and the skill requires both for a new visual world, so they are
# re-included too. The `**/` forms matter: a bare `.impeccable/` rule is
# unanchored and matches the nested `themes/<theme>/.impeccable/` as well, but a
# negation like `!.impeccable/surfaces/` (a slash inside the pattern anchors it
# to this file's directory) would only ever re-include the repo-root copy.
!.impeccable/
.impeccable/*
!.impeccable/config.json
!**/.impeccable/design.json
!**/.impeccable/surfaces/
!**/.impeccable/surfaces/**
!.impeccable/mocks/
.impeccable/mocks/*
!.impeccable/mocks/decision/
.impeccable/mocks/decision/*
!.impeccable/mocks/decision/*.json

# Directory containing archived landing page mockups
docs/design/mockups/archived/*.html
docs/design/mockups/archived/*.md
docs/design/mockups/archived/*.jpg